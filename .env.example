# Launch date in ISO 8601 (UTC). Used by the countdown on the landing page.
# If unset, defaults to 45 days from build time.
NEXT_PUBLIC_LAUNCH_DATE="2026-08-01T00:00:00Z"

# Optional: forward subscribers to an ESP. Leave empty to log to server console only.
# Klaviyo example:
# KLAVIYO_LIST_ID=
# KLAVIYO_PRIVATE_KEY=
# Mailchimp example:
# MAILCHIMP_API_KEY=
# MAILCHIMP_AUDIENCE_ID=
# MAILCHIMP_DC=
